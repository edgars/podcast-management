# -----------------------------------------------------------------------------
# Neon (PostgreSQL) — Vercel + Prisma
# -----------------------------------------------------------------------------
# No dashboard Neon: copie a connection string "Pooled" para DATABASE_URL
# e a "Direct" (non-pooling) para DIRECT_URL.
#
# Formato típico:
#   DATABASE_URL="postgresql://USER:PASSWORD@EP-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@EP-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Se o host da URL pooled contiver "-pooler" ou parâmetros de pooler, mantenha-os apenas em DATABASE_URL.
# DIRECT_URL deve apontar para o endpoint direto (migrations / introspection).

# Pooled: host contém "-pooler" (ex.: ep-abc-123-pooler.sa-east-1.aws.neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER/neondb?sslmode=require"
# Direct: copie a string "Direct" do Neon — mesmo USER/PASSWORD e mesmo /database;
# o host NÃO deve ser o pooler (sem "-pooler" no nome do endpoint).
DIRECT_URL="postgresql://USER:PASSWORD@HOST-DIRECT-SAME-REGION/neondb?sslmode=require"
#
# Se aparecer P1001: confira no Neon se o projeto está ativo, se o host bate com o
# dashboard, e teste sem channel_binding na URL. Firewall/VPN pode bloquear a porta 5432.

# NextAuth / Auth.js — obrigatório em produção (na Vercel: Environment Variables)
# Pode usar AUTH_SECRET ou o nome legado NEXTAUTH_SECRET.
AUTH_SECRET="cole-aqui-uma-string-longa-aleatoria"
AUTH_URL="http://localhost:3000"
